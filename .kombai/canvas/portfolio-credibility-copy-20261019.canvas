      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n.portfolio-preview { color:#252525; background:#fff; font-family:\"Segoe UI\",Tahoma,Geneva,Verdana,sans-serif; line-height:1.6; }\n  .portfolio-preview a { color:inherit; text-decoration:none; }\n  .portfolio-preview header { position:fixed; top:0; left:0; z-index:1000; width:100%; padding:1rem 2rem; color:#fff; background:rgba(16,16,16,.96); backdrop-filter:blur(12px); }\n  .portfolio-preview nav { max-width:1180px; margin:auto; display:flex; justify-content:space-between; align-items:center; position:relative; }\n  .portfolio-preview nav h2 { margin:0; color:#fff; font-size:1.35rem; letter-spacing:0; }\n  .portfolio-preview .menu { display:flex; gap:1.5rem; }\n  .portfolio-preview .menu a { color:#fff; font-size:.95rem; }\n  .portfolio-preview .menu a:hover { color:#f39c12; }\n  .portfolio-preview .menu-icon { display:none; }\n  .portfolio-preview .hero { min-height:100vh; padding:7rem 1.5rem 4rem; display:flex; justify-content:center; align-items:center; text-align:center; color:#fff; background:linear-gradient(rgba(0,0,0,.68),rgba(0,0,0,.7)),url('/api/local/images/images/background.jpg') center/cover no-repeat; }\n  .portfolio-preview .hero-content { max-width:850px; }\n  .portfolio-preview .hero-tag { display:inline-block; padding:.45rem .9rem; margin-bottom:1.2rem; border:1px solid rgba(255,255,255,.35); border-radius:999px; color:#ffe4b2; font-size:.9rem; }\n  .portfolio-preview .hero h1 { margin:0 0 1rem; font-size:clamp(2.35rem,6vw,4.8rem); line-height:1.08; }\n  .portfolio-preview .hero-role { margin:0 0 1rem; color:#ffe4b2; font-size:1.35rem; font-weight:700; }\n  .portfolio-preview .hero-summary { max-width:680px; margin:0 auto 2rem; color:rgba(255,255,255,.9); font-size:1.08rem; }\n  .portfolio-preview .hero-actions { display:flex; justify-content:center; gap:1rem; flex-wrap:wrap; }\n  .portfolio-preview .btn,.portfolio-preview .btn-card { display:inline-block; padding:.78rem 1.45rem; border-radius:999px; color:#fff; background:#f39c12; font-weight:700; transition:background .3s,transform .3s; }\n  .portfolio-preview .btn:hover,.portfolio-preview .btn-card:hover { background:#d97806; transform:translateY(-2px); }\n  .portfolio-preview .btn-secondary { border:1px solid rgba(255,255,255,.6); background:transparent; }\n  .portfolio-preview .btn-secondary:hover { color:#101010; background:#fff; }\n  .portfolio-preview section { max-width:1120px; margin:auto; padding:5.5rem 2rem; scroll-margin-top:5rem; }\n  .portfolio-preview .section-alt { max-width:none; background:#f7f4ef; }\n  .portfolio-preview .section-alt > h2,.portfolio-preview .section-alt > .section-intro,.portfolio-preview .section-alt > .services-grid,.portfolio-preview .section-alt > .process-grid { max-width:1120px; margin-right:auto; margin-left:auto; }\n  .portfolio-preview section h2 { margin:0 0 1rem; color:#101010; text-align:center; font-size:clamp(1.9rem,4vw,2.6rem); }\n  .portfolio-preview .section-intro { max-width:720px; margin:0 auto 2.5rem; color:#666; text-align:center; }\n  .portfolio-preview .about { display:flex; flex-wrap:wrap; align-items:center; gap:2.5rem; }\n  .portfolio-preview .about img { flex:1 1 280px; max-width:310px; aspect-ratio:1; object-fit:cover; border-radius:50%; box-shadow:0 18px 45px rgba(0,0,0,.12); }\n  .portfolio-preview .about-text { flex:2 1 420px; }\n  .portfolio-preview .about-text p { margin:0 0 1.1rem; color:#444; }\n  .portfolio-preview .services-grid,.portfolio-preview .process-grid,.portfolio-preview .portfolio-grid { display:grid; gap:1.5rem; }\n  .portfolio-preview .services-grid { grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); }\n  .portfolio-preview .service-card,.portfolio-preview .process-step,.portfolio-preview .portfolio-item,.portfolio-preview .testimonial-box { border:1px solid rgba(16,16,16,.1); border-radius:8px; background:#fff; box-shadow:0 12px 30px rgba(0,0,0,.08); }\n  .portfolio-preview .service-card,.portfolio-preview .process-step { padding:1.5rem; }\n  .portfolio-preview .service-card h3,.portfolio-preview .process-step h3 { margin:0 0 .65rem; color:#101010; }\n  .portfolio-preview .service-card p,.portfolio-preview .process-step p { margin:0; color:#666; }\n  .portfolio-preview .portfolio-switcher { min-width:0; margin:0; padding:0; border:0; }\n  .portfolio-preview .visually-hidden { position:absolute; width:1px; height:1px; margin:-1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); clip-path:inset(50%); white-space:nowrap; border:0; }\n  .portfolio-preview .portfolio-switcher__input { position:absolute; }\n  .portfolio-preview .portfolio-switcher__options { display:flex; width:fit-content; max-width:100%; margin:0 auto 2rem; padding:.25rem; align-items:center; justify-content:center; gap:.25rem; border:1px solid rgba(16,16,16,.1); border-radius:999px; background:#f7f4ef; }\n  .portfolio-preview .portfolio-switcher__option { display:inline-flex; min-height:44px; padding:.6rem 1.25rem; align-items:center; justify-content:center; border:1px solid transparent; border-radius:999px; color:#252525; font-weight:700; line-height:1.2; white-space:nowrap; cursor:pointer; }\n  .portfolio-preview .portfolio-switcher__option:hover { color:#d97806; }\n  .portfolio-preview #portfolio-websites:checked ~ .portfolio-switcher__options label[for=\"portfolio-websites\"],.portfolio-preview #portfolio-product-design:checked ~ .portfolio-switcher__options label[for=\"portfolio-product-design\"] { color:#f39c12; background:#101010; }\n  .portfolio-preview #portfolio-websites:focus-visible ~ .portfolio-switcher__options label[for=\"portfolio-websites\"],.portfolio-preview #portfolio-product-design:focus-visible ~ .portfolio-switcher__options label[for=\"portfolio-product-design\"] { outline:3px solid #d97806; outline-offset:3px; }\n  .portfolio-preview #portfolio-product-design:checked ~ .portfolio-switcher__panels .portfolio-grid { display:none; }\n  .portfolio-preview .portfolio-switcher__empty { display:none; min-height:18rem; padding:3rem 1rem; align-items:center; justify-content:center; flex-direction:column; text-align:center; }\n  .portfolio-preview #portfolio-product-design:checked ~ .portfolio-switcher__panels .portfolio-switcher__empty { display:flex; }\n  .portfolio-preview .portfolio-switcher__empty h3 { max-width:32rem; margin:0 0 .7rem; color:#101010; font-size:clamp(1.5rem,3vw,2.15rem); line-height:1.25; }\n  .portfolio-preview .portfolio-switcher__empty p { max-width:34rem; margin:0; color:#666; }\n  .portfolio-preview .portfolio-grid { grid-template-columns:repeat(4,1fr); align-items:stretch; }\n  .portfolio-preview .portfolio-item { display:flex; height:100%; overflow:hidden; flex-direction:column; text-align:left; transition:transform .3s,box-shadow .3s; }\n  .portfolio-preview .portfolio-item img { display:block; width:100%; height:210px; object-fit:cover; }\n  .portfolio-preview .card-content { display:flex; flex:1; padding:1.2rem; flex-direction:column; }\n  .portfolio-preview .card-content h3 { margin:0 0 .55rem; font-size:1.2rem; }\n  .portfolio-preview .card-content p { flex:1; margin:0 0 1rem; color:#666; font-size:.95rem; line-height:1.5; }\n  .portfolio-preview .card-content .btn-card { align-self:flex-start; margin-top:auto; }\n  .portfolio-preview .portfolio-item:hover { transform:translateY(-5px); box-shadow:0 18px 45px rgba(0,0,0,.12); }\n  .portfolio-preview #case-studies { padding-top:0; }\n  .portfolio-preview .case-study { display:none; max-width:920px; margin:2rem auto; padding:3rem 2rem; border:1px solid rgba(16,16,16,.1); border-radius:8px; background:#fff; box-shadow:0 18px 45px rgba(0,0,0,.12); }\n  .portfolio-preview .case-study:target { display:block; }\n  .portfolio-preview .case-study h2 { font-size:1.8rem; }\n  .portfolio-preview .case-study h3 { margin:0 0 2rem; color:#666; text-align:center; font-size:1.1rem; }\n  .portfolio-preview .cs-section { margin-bottom:1.5rem; }\n  .portfolio-preview .cs-section h4 { margin:0 0 .5rem; color:#d97806; font-size:1.1rem; }\n  .portfolio-preview .cs-section p,.portfolio-preview .cs-section ul { color:#666; }\n  .portfolio-preview .cs-section ul { margin-left:1.2rem; }\n  .portfolio-preview .process-grid { grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); }\n  .portfolio-preview .process-step span { display:inline-block; margin-bottom:.8rem; color:#d97806; font-weight:800; }\n  .portfolio-preview .testimonial-box { max-width:780px; margin:0 auto; padding:2rem; text-align:center; }\n  .portfolio-preview .testimonial-box p { margin:0; color:#444; font-size:1.08rem; }\n  .portfolio-preview .contact { text-align:center; }\n  .portfolio-preview .contact-intro { max-width:650px; margin:0 auto 1.5rem; color:#666; }\n  .portfolio-preview .contact-cta { margin-bottom:1rem; }\n  .portfolio-preview .contact-list { margin:1.5rem 0 0; padding:0; list-style:none; }\n  .portfolio-preview .contact-list li { margin:1rem 0; }\n  .portfolio-preview .contact-list a { display:inline-flex; align-items:center; gap:.6rem; color:#101010; font-size:1.05rem; }\n  .portfolio-preview .contact-icon { width:24px; height:24px; padding:2px; border-radius:5px; object-fit:contain; background:#fff; box-shadow:0 2px 6px rgba(0,0,0,.2); }\n  .portfolio-preview footer { padding:1.5rem; color:#fff; background:#101010; text-align:center; }\n  .portfolio-preview footer p { margin:0; }\n  @media (max-width:1100px) { .portfolio-preview .portfolio-grid { grid-template-columns:repeat(2,1fr); } }\n  @media (max-width:768px) {\n    .portfolio-preview header { padding:1rem; }\n    .portfolio-preview .menu-icon { position:absolute; top:50%; right:0; z-index:1100; display:block; transform:translateY(-50%); cursor:pointer; }\n    .portfolio-preview .menu-icon img { width:32px; height:32px; }\n    .portfolio-preview .menu-icon .close-img { display:none; }\n    .portfolio-preview .menu { position:absolute; top:54px; right:0; max-height:0; width:230px; overflow:hidden; flex-direction:column; border-radius:0 0 8px 8px; background:#101010; transition:max-height .3s ease-in-out; }\n    .portfolio-preview .menu a { padding:1rem; border-bottom:1px solid #222; }\n    .portfolio-preview #menu:target { max-height:500px; }\n    .portfolio-preview #menu:target ~ .menu-icon .menu-img { display:none; }\n    .portfolio-preview #menu:target ~ .menu-icon .close-img { display:inline; }\n    .portfolio-preview section { padding:4.5rem 1.2rem; }\n    .portfolio-preview .hero { min-height:92vh; padding-top:6rem; }\n    .portfolio-preview .hero-role { font-size:1.1rem; }\n    .portfolio-preview .about { flex-direction:column; text-align:center; }\n    .portfolio-preview .contact-list a { font-size:.95rem; word-break:break-word; }\n    .portfolio-preview .portfolio-switcher__options { margin-bottom:1.5rem; }\n    .portfolio-preview .portfolio-switcher__option { padding-right:1rem; padding-left:1rem; }\n    .portfolio-preview .portfolio-switcher__empty { min-height:15rem; padding-right:0; padding-left:0; }\n  }\n  @media (max-width:600px) {\n    .portfolio-preview .portfolio-grid { grid-template-columns:1fr; }\n    .portfolio-preview .portfolio-switcher__options { gap:.1rem; }\n    .portfolio-preview .portfolio-switcher__option { padding-right:.75rem; padding-left:.75rem; font-size:.9rem; }\n  }\n</style>\n<div class=\"portfolio-preview\" data-kid=\"1\" data-name=\"portfolio page container\">\n    <header data-kid=\"1-1\" data-name=\"site header\">\n        <nav data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n            <h2 data-kid=\"1-1-1-1\" data-name=\"site brand name\">\n                Constance\n            </h2>\n            <div class=\"menu\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\" id=\"menu\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\" href=\"#hero\">\n                    Home\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"about navigation link\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"services navigation link\" href=\"#services\">\n                    Services\n                </a>\n                <a data-kid=\"1-1-1-2-4\" data-name=\"portfolio navigation link\" href=\"#portfolio\">\n                    Portfolio\n                </a>\n                <a data-kid=\"1-1-1-2-5\" data-name=\"contact navigation link\" href=\"#contact\">\n                    Contact\n                </a>\n            </div>\n            <a aria-label=\"Open menu\" class=\"menu-icon open-btn\" data-kid=\"1-1-1-3\" data-name=\"mobile menu open toggle\" href=\"#menu\">\n                <img alt=\"\" class=\"menu-img\" data-kid=\"1-1-1-3-1\" data-name=\"hamburger menu icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/menu-icon.png\"/>\n            </a>\n            <a aria-label=\"Close menu\" class=\"menu-icon close-btn\" data-kid=\"1-1-1-4\" data-name=\"mobile menu close toggle\" href=\"#\">\n                <img alt=\"\" class=\"close-img\" data-kid=\"1-1-1-4-1\" data-name=\"close menu icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/close-icon.png\"/>\n            </a>\n        </nav>\n    </header>\n    <section class=\"hero\" data-kid=\"1-2\" data-name=\"hero section\" id=\"hero\">\n        <div class=\"hero-content\" data-kid=\"1-2-1\" data-name=\"hero content container\">\n            <span class=\"hero-tag\" data-kid=\"1-2-1-1\" data-name=\"availability status tag\">\n                Web Development & Product Design\n            </span>\n            <h1 data-kid=\"1-2-1-2\" data-name=\"hero headline\">\n                Hello, I'm Akporiome Constance\n            </h1>\n            <p class=\"hero-role\" data-kid=\"1-2-1-3\" data-name=\"hero role subtitle\">\n                Web Developer | Product Designer\n            </p>\n            <p class=\"hero-summary\" data-kid=\"1-2-1-4\" data-name=\"hero summary description\">\n                I design digital product interfaces and build responsive websites for schools, businesses, and growing brands.\n            </p>\n            <div class=\"hero-actions\" data-kid=\"1-2-1-5\" data-name=\"hero call-to-action buttons\">\n                <a class=\"btn\" data-kid=\"1-2-1-5-1\" data-name=\"primary hire-me button\" href=\"#contact\">\n                    Start a Project\n                </a>\n                <a class=\"btn btn-secondary\" data-kid=\"1-2-1-5-2\" data-name=\"secondary view-work button\" href=\"#portfolio\">\n                    View My Work\n                </a>\n            </div>\n        </div>\n    </section>\n    <section data-kid=\"1-3\" data-name=\"about section\" id=\"about\">\n        <h2 data-kid=\"1-3-1\" data-name=\"about section heading\">\n            About Me\n        </h2>\n        <div class=\"about\" data-kid=\"1-3-2\" data-name=\"about content layout\">\n            <img alt=\"Akporiome Constance profile picture\" data-kid=\"1-3-2-1\" data-name=\"profile photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/profile1.jpg\"/>\n            <div class=\"about-text\" data-kid=\"1-3-2-2\" data-name=\"about text block\">\n                <p data-kid=\"1-3-2-2-1\" data-name=\"introduction paragraph with role emphasis\">\n                    I create responsive websites and digital product interfaces for businesses, schools, and growing brands.\n                </p>\n                <p data-kid=\"1-3-2-2-2\" data-name=\"digital setup description paragraph\">\n                    My work includes developing responsive websites and designing digital product interfaces, with clear layouts and practical interactions.\n                </p>\n                <p data-kid=\"1-3-2-2-3\" data-name=\"skill highlights paragraph\">\n                    <strong data-kid=\"1-3-2-2-3-1\" data-name=\"skill list heading emphasis\">\n                        What I Bring to Your Project:\n                    </strong>\n                    Website development with HTML5, CSS3, and JavaScript, plus interface design for websites and digital products.\n                </p>\n                <p data-kid=\"1-3-2-2-4\" data-name=\"goal statement paragraph\">\n                    My focus is on practical websites and digital product interfaces that present information clearly and are easy to navigate.\n                </p>\n            </div>\n        </div>\n    </section>\n    <section class=\"section-alt\" data-kid=\"1-4\" data-name=\"services section\" id=\"services\">\n        <h2 data-kid=\"1-4-1\" data-name=\"services section heading\">\n            Services\n        </h2>\n        <p class=\"section-intro\" data-kid=\"1-4-2\" data-name=\"services section intro text\">\n            Website development, product interface design, and visual design for businesses, schools, personal brands, and organizations.\n        </p>\n        <div class=\"services-grid\" data-kid=\"1-4-3\" data-name=\"services card grid\">\n            <div class=\"service-card\" data-kid=\"1-4-3-1\" data-name=\"business websites service card\">\n                <h3 data-kid=\"1-4-3-1-1\" data-name=\"service card title: Business Websites\">\n                    Business Websites\n                </h3>\n                <p data-kid=\"1-4-3-1-2\" data-name=\"service card description: Business Websites\">\n                    Modern responsive websites that explain your services clearly and make it easier for customers to contact you.\n                </p>\n            </div>\n            <div class=\"service-card\" data-kid=\"1-4-3-2\" data-name=\"school websites service card\">\n                <h3 data-kid=\"1-4-3-2-1\" data-name=\"service card title: School & Organization Websites\">\n                    School & Organization Websites\n                </h3>\n                <p data-kid=\"1-4-3-2-2\" data-name=\"service card description: School & Organization Websites\">\n                    Clean websites for schools and groups with pages for information, gallery, announcements, and contact details.\n                </p>\n            </div>\n            <div class=\"service-card\" data-kid=\"1-4-3-3\" data-name=\"portfolio websites service card\">\n                <h3 data-kid=\"1-4-3-3-1\" data-name=\"service card title: Portfolio Websites\">\n                    Portfolio Websites\n                </h3>\n                <p data-kid=\"1-4-3-3-2\" data-name=\"service card description: Portfolio Websites\">\n                    Personal portfolio and brand websites for students, creatives, professionals, and freelancers.\n                </p>\n            </div>\n            <div class=\"service-card\" data-kid=\"1-4-3-4\" data-name=\"graphics design service card\">\n                <h3 data-kid=\"1-4-3-4-1\" data-name=\"service card title: Graphics & Visual Design\">\n                    Graphics & Visual Design\n                </h3>\n                <p data-kid=\"1-4-3-4-2\" data-name=\"service card description: Graphics & Visual Design\">\n                    Simple brand graphics, layout direction, and visual improvements that help your online presence feel polished.\n                </p>\n            </div>\n        </div>\n    </section>\n    <section data-kid=\"1-5\" data-name=\"portfolio projects section\" id=\"portfolio\">\n        <h2 data-kid=\"1-5-1\" data-name=\"portfolio section heading\">\n            Featured Projects\n        </h2>\n        <p class=\"section-intro\" data-kid=\"1-5-2\" data-name=\"portfolio section intro text\">\n            Responsive website projects and a mentorship dashboard, with a dedicated product design case study in progress.\n        </p>\n        <fieldset class=\"portfolio-switcher\" data-kid=\"1-5-3\" data-name=\"project category switcher fieldset\">\n            <legend class=\"visually-hidden\" data-kid=\"1-5-3-1\" data-name=\"switcher accessible label (hidden)\">\n                Choose a project category\n            </legend>\n            <input aria-controls=\"website-projects\" checked=\"\" class=\"portfolio-switcher__input visually-hidden\" data-kid=\"1-5-3-2\" data-name=\"websites category radio input\" id=\"portfolio-websites\" name=\"portfolio-category\" type=\"radio\" value=\"websites\"/>\n            <input aria-controls=\"product-design-panel\" class=\"portfolio-switcher__input visually-hidden\" data-kid=\"1-5-3-3\" data-name=\"product design category radio input\" id=\"portfolio-product-design\" name=\"portfolio-category\" type=\"radio\" value=\"product-design\"/>\n            <div class=\"portfolio-switcher__options\" data-kid=\"1-5-3-4\" data-name=\"category switcher labels bar\">\n                <label class=\"portfolio-switcher__option\" data-kid=\"1-5-3-4-1\" data-name=\"websites category tab\" for=\"portfolio-websites\" id=\"portfolio-websites-label\">\n                    Websites\n                </label>\n                <label class=\"portfolio-switcher__option\" data-kid=\"1-5-3-4-2\" data-name=\"product design category tab\" for=\"portfolio-product-design\" id=\"portfolio-product-design-label\">\n                    Product Design\n                </label>\n            </div>\n            <div class=\"portfolio-switcher__panels\" data-kid=\"1-5-3-5\" data-name=\"category panels container\">\n                <div aria-labelledby=\"portfolio-websites-label\" class=\"portfolio-grid\" data-kid=\"1-5-3-5-1\" data-name=\"websites projects grid\" id=\"website-projects\" role=\"region\">\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-1\" data-name=\"project card: De Amazing School\">\n                        <img alt=\"De Amazing School website preview\" data-kid=\"1-5-3-5-1-1-1\" data-name=\"project preview image: De Amazing School\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/deamazing-school.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-1-2\" data-name=\"project card body: De Amazing School\">\n                            <h3 data-kid=\"1-5-3-5-1-1-2-1\" data-name=\"project title: De Amazing School Website\">\n                                De Amazing School Website\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-1-2-2\" data-name=\"project description: De Amazing School Website\">\n                                A live school website with school information and clear navigation for parents, students, and visitors.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-1-2-3\" data-name=\"view details button: De Amazing School\" href=\"#case5\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-2\" data-name=\"project card: Ideal360\">\n                        <img alt=\"Ideal360 website preview\" data-kid=\"1-5-3-5-1-2-1\" data-name=\"project preview image: Ideal360\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ideal360.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-2-2\" data-name=\"project card body: Ideal360\">\n                            <h3 data-kid=\"1-5-3-5-1-2-2-1\" data-name=\"project title: Ideal360 Website\">\n                                Ideal360 Website\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-2-2-2\" data-name=\"project description: Ideal360 Website\">\n                                A responsive business website presenting the brand's services and information in clear sections.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-2-2-3\" data-name=\"view details button: Ideal360\" href=\"#case6\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-3\" data-name=\"project card: Olushola Birthday Tribute\">\n                        <img alt=\"Olushola Akinrimisi birthday tribute website preview\" data-kid=\"1-5-3-5-1-3-1\" data-name=\"project preview image: Olushola Akinrimisi\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/olushola-akinrimisi.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-3-2\" data-name=\"project card body: Olushola Birthday Tribute\">\n                            <h3 data-kid=\"1-5-3-5-1-3-2-1\" data-name=\"project title: Olushola Akinrimisi Birthday Tribute\">\n                                Olushola Akinrimisi Birthday Tribute\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-3-2-2\" data-name=\"project description: Olushola Akinrimisi Birthday Tribute\">\n                                A birthday tribute website featuring a personal message, photographs, and a celebration-focused layout.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-3-2-3\" data-name=\"view details button: Olushola Birthday Tribute\" href=\"#case7\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-4\" data-name=\"project card: Deallahdey Properties\">\n                        <img alt=\"Deallahdey Properties website preview\" data-kid=\"1-5-3-5-1-4-1\" data-name=\"project preview image: Deallahdey Properties\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/deallahdey-properties.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-4-2\" data-name=\"project card body: Deallahdey Properties\">\n                            <h3 data-kid=\"1-5-3-5-1-4-2-1\" data-name=\"project title: Deallahdey Properties Website\">\n                                Deallahdey Properties Website\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-4-2-2\" data-name=\"project description: Deallahdey Properties Website\">\n                                A responsive real estate website showcasing property services and listings.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-4-2-3\" data-name=\"view details button: Deallahdey Properties\" href=\"#case8\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-5\" data-name=\"project card: DE-GREAT School\">\n                        <img alt=\"DE-GREAT School Website preview\" data-kid=\"1-5-3-5-1-5-1\" data-name=\"project preview image: DE-GREAT School\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/school-cs.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-5-2\" data-name=\"project card body: DE-GREAT School\">\n                            <h3 data-kid=\"1-5-3-5-1-5-2-1\" data-name=\"project title: DE-GREAT School Website\">\n                                DE-GREAT School Website\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-5-2-2\" data-name=\"project description: DE-GREAT School Website\">\n                                A responsive school website presenting school information across Home, About, Gallery, and Contact pages.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-5-2-3\" data-name=\"view details button: DE-GREAT School\" href=\"#case1\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-6\" data-name=\"project card: Mentup Konnect Dashboard\">\n                        <img alt=\"Mentup Konnect Dashboard preview\" data-kid=\"1-5-3-5-1-6-1\" data-name=\"project preview image: Mentup Konnect Dashboard\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/mentee-screenshot.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-6-2\" data-name=\"project card body: Mentup Konnect Dashboard\">\n                            <h3 data-kid=\"1-5-3-5-1-6-2-1\" data-name=\"project title: Mentup Konnect Dashboard\">\n                                Mentup Konnect Dashboard\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-6-2-2\" data-name=\"project description: Mentup Konnect Dashboard\">\n                                A mentorship dashboard for viewing mentors, requests, sessions, and engagement activity.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-6-2-3\" data-name=\"view details button: Mentup Konnect Dashboard\" href=\"#case2\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-7\" data-name=\"project card: DeepOcean Clone\">\n                        <img alt=\"DeepOcean frontpage clone preview\" data-kid=\"1-5-3-5-1-7-1\" data-name=\"project preview image: DeepOcean Frontpage Clone\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/deepocean-media.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-7-2\" data-name=\"project card body: DeepOcean Clone\">\n                            <h3 data-kid=\"1-5-3-5-1-7-2-1\" data-name=\"project title: DeepOcean Frontpage Clone\">\n                                DeepOcean Frontpage Clone\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-7-2-2\" data-name=\"project description: DeepOcean Frontpage Clone\">\n                                A responsive recreation of a corporate homepage with hero banners, service highlights, ESG content, and media sections.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-7-2-3\" data-name=\"view details button: DeepOcean Clone\" href=\"#case3\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"portfolio-item\" data-kid=\"1-5-3-5-1-8\" data-name=\"project card: Aptech Homepage\">\n                        <img alt=\"Aptech homepage design preview\" data-kid=\"1-5-3-5-1-8-1\" data-name=\"project preview image: Aptech Homepage Design\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/aptech-cs.png\"/>\n                        <div class=\"card-content\" data-kid=\"1-5-3-5-1-8-2\" data-name=\"project card body: Aptech Homepage\">\n                            <h3 data-kid=\"1-5-3-5-1-8-2-1\" data-name=\"project title: Aptech Homepage Design\">\n                                Aptech Homepage Design\n                            </h3>\n                            <p data-kid=\"1-5-3-5-1-8-2-2\" data-name=\"project description: Aptech Homepage Design\">\n                                A responsive homepage for a tech education brand, with navigation and sections for bootcamps, teams, and job opportunities.\n                            </p>\n                            <a class=\"btn-card\" data-kid=\"1-5-3-5-1-8-2-3\" data-name=\"view details button: Aptech Homepage\" href=\"#case4\">\n                                View Details\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div aria-labelledby=\"product-design-title\" class=\"portfolio-switcher__empty\" data-kid=\"1-5-3-5-2\" data-name=\"product design placeholder panel\" id=\"product-design-panel\" role=\"region\">\n                    <h3 data-kid=\"1-5-3-5-2-1\" data-name=\"placeholder heading: Product Design\" id=\"product-design-title\">\n                        Product design case study in progress.\n                    </h3>\n                    <p data-kid=\"1-5-3-5-2-2\" data-name=\"placeholder description: Product Design\">\n                        Current featured projects include responsive websites and a mentorship dashboard.\n                    </p>\n                </div>\n            </div>\n        </fieldset>\n    </section>\n    <section data-kid=\"1-6\" data-name=\"case studies section\" id=\"case-studies\">\n        <div class=\"case-study\" data-kid=\"1-6-1\" data-name=\"case study: De Amazing School\" id=\"case5\">\n            <h2 data-kid=\"1-6-1-1\" data-name=\"case study headline: De Amazing School\">\n                De Amazing School Website\n            </h2>\n            <h3 data-kid=\"1-6-1-2\" data-name=\"case study subtype subtitle: De Amazing School\">\n                Responsive School Website\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-1-3\" data-name=\"case study overview section: De Amazing School\">\n                <h4 data-kid=\"1-6-1-3-1\" data-name=\"section label: Overview (De Amazing School)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-1-3-2\" data-name=\"overview text: De Amazing School\">\n                    A responsive school website presenting key information for parents and visitors, with organized sections and contact-focused navigation.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-1-4\" data-name=\"case study tools section: De Amazing School\">\n                <h4 data-kid=\"1-6-1-4-1\" data-name=\"section label: Tools & Process (De Amazing School)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-1-4-2\" data-name=\"tools list: De Amazing School\">\n                    <li data-kid=\"1-6-1-4-2-1\" data-name=\"tools list item (De Amazing School)\">\n                        Built with HTML, CSS, and JavaScript\n                    </li>\n                    <li data-kid=\"1-6-1-4-2-2\" data-name=\"tools list item (De Amazing School)\">\n                        Responsive layout for mobile and desktop users\n                    </li>\n                    <li data-kid=\"1-6-1-4-2-3\" data-name=\"tools list item (De Amazing School)\">\n                        Organized school information into clear website sections\n                    </li>\n                    <li data-kid=\"1-6-1-4-2-4\" data-name=\"tools list item (De Amazing School)\">\n                        Added contact-focused navigation for enquiries\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-1-5\" data-name=\"case study outcome section: De Amazing School\">\n                <h4 data-kid=\"1-6-1-5-1\" data-name=\"section label: Outcome (De Amazing School)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-1-5-2\" data-name=\"outcome text: De Amazing School\">\n                    The website organizes school information for parents, students, and visitors, with navigation to key sections and contact details.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-1-6\" data-name=\"view live site button: De Amazing School\" href=\"https://deamazingschool.netlify.app/\" target=\"_blank\">\n                View Live Site\n            </a>\n            <a class=\"btn-card\" data-kid=\"1-6-1-7\" data-name=\"back to portfolio button: De Amazing School\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-2\" data-name=\"case study: Ideal360\" id=\"case6\">\n            <h2 data-kid=\"1-6-2-1\" data-name=\"case study headline: Ideal360\">\n                Ideal360 Website\n            </h2>\n            <h3 data-kid=\"1-6-2-2\" data-name=\"case study subtype subtitle: Ideal360\">\n                Responsive Business Website\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-2-3\" data-name=\"case study overview section: Ideal360\">\n                <h4 data-kid=\"1-6-2-3-1\" data-name=\"section label: Overview (Ideal360)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-2-3-2\" data-name=\"overview text: Ideal360\">\n                    A responsive business website presenting brand and service information in clear sections, with a path for visitors to make contact.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-2-4\" data-name=\"case study tools section: Ideal360\">\n                <h4 data-kid=\"1-6-2-4-1\" data-name=\"section label: Tools & Process (Ideal360)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-2-4-2\" data-name=\"tools list: Ideal360\">\n                    <li data-kid=\"1-6-2-4-2-1\" data-name=\"tools list item (Ideal360)\">\n                        Created a responsive website structure\n                    </li>\n                    <li data-kid=\"1-6-2-4-2-2\" data-name=\"tools list item (Ideal360)\">\n                        Used clear sections to present services and brand information\n                    </li>\n                    <li data-kid=\"1-6-2-4-2-3\" data-name=\"tools list item (Ideal360)\">\n                        Focused on clean layout, readability, and easy navigation\n                    </li>\n                    <li data-kid=\"1-6-2-4-2-4\" data-name=\"tools list item (Ideal360)\">\n                        Optimized the design for both desktop and mobile screens\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-2-5\" data-name=\"case study outcome section: Ideal360\">\n                <h4 data-kid=\"1-6-2-5-1\" data-name=\"section label: Outcome (Ideal360)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-2-5-2\" data-name=\"outcome text: Ideal360\">\n                    The site brings the brand's service information and contact path together in a responsive website layout.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-2-6\" data-name=\"view live site button: Ideal360\" href=\"https://ideal360.netlify.app/\" target=\"_blank\">\n                View Live Site\n            </a>\n            <a class=\"btn-card\" data-kid=\"1-6-2-7\" data-name=\"back to portfolio button: Ideal360\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-3\" data-name=\"case study: Olushola Birthday Tribute\" id=\"case7\">\n            <h2 data-kid=\"1-6-3-1\" data-name=\"case study headline: Olushola Birthday Tribute\">\n                Olushola Akinrimisi Birthday Tribute\n            </h2>\n            <h3 data-kid=\"1-6-3-2\" data-name=\"case study subtype subtitle: Olushola Birthday Tribute\">\n                Celebration Website\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-3-3\" data-name=\"case study overview section: Olushola Birthday Tribute\">\n                <h4 data-kid=\"1-6-3-3-1\" data-name=\"section label: Overview (Olushola Birthday Tribute)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-3-3-2\" data-name=\"overview text: Olushola Birthday Tribute\">\n                    This birthday tribute website was created to celebrate Olushola Akinrimisi with a personal, warm, and memorable online experience for a special occasion.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-3-4\" data-name=\"case study tools section: Olushola Birthday Tribute\">\n                <h4 data-kid=\"1-6-3-4-1\" data-name=\"section label: Tools & Process (Olushola Birthday Tribute)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-3-4-2\" data-name=\"tools list: Olushola Birthday Tribute\">\n                    <li data-kid=\"1-6-3-4-2-1\" data-name=\"tools list item (Olushola Birthday Tribute)\">\n                        Designed a celebration-focused website layout\n                    </li>\n                    <li data-kid=\"1-6-3-4-2-2\" data-name=\"tools list item (Olushola Birthday Tribute)\">\n                        Structured the content around tribute messaging and personal presentation\n                    </li>\n                    <li data-kid=\"1-6-3-4-2-3\" data-name=\"tools list item (Olushola Birthday Tribute)\">\n                        Built a responsive experience for mobile and desktop visitors\n                    </li>\n                    <li data-kid=\"1-6-3-4-2-4\" data-name=\"tools list item (Olushola Birthday Tribute)\">\n                        Focused on warmth, readability, and emotional presentation\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-3-5\" data-name=\"case study outcome section: Olushola Birthday Tribute\">\n                <h4 data-kid=\"1-6-3-5-1\" data-name=\"section label: Outcome (Olushola Birthday Tribute)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-3-5-2\" data-name=\"outcome text: Olushola Birthday Tribute\">\n                    The site brings the tribute message and celebration photos together in a dedicated web page.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-3-6\" data-name=\"view live site button: Olushola Birthday Tribute\" href=\"https://olushola-akinrimisi.netlify.app/\" target=\"_blank\">\n                View Live Site\n            </a>\n            <a class=\"btn-card\" data-kid=\"1-6-3-7\" data-name=\"back to portfolio button: Olushola Birthday Tribute\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-4\" data-name=\"case study: Deallahdey Properties\" id=\"case8\">\n            <h2 data-kid=\"1-6-4-1\" data-name=\"case study headline: Deallahdey Properties\">\n                Deallahdey Properties Website\n            </h2>\n            <h3 data-kid=\"1-6-4-2\" data-name=\"case study subtype subtitle: Deallahdey Properties\">\n                Real Estate Website\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-4-3\" data-name=\"case study overview section: Deallahdey Properties\">\n                <h4 data-kid=\"1-6-4-3-1\" data-name=\"section label: Overview (Deallahdey Properties)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-4-3-2\" data-name=\"overview text: Deallahdey Properties\">\n                    A responsive real estate website presenting property services and directing visitors to enquiry information.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-4-4\" data-name=\"case study tools section: Deallahdey Properties\">\n                <h4 data-kid=\"1-6-4-4-1\" data-name=\"section label: Tools & Process (Deallahdey Properties)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-4-4-2\" data-name=\"tools list: Deallahdey Properties\">\n                    <li data-kid=\"1-6-4-4-2-1\" data-name=\"tools list item (Deallahdey Properties)\">\n                        Created a responsive real estate website layout\n                    </li>\n                    <li data-kid=\"1-6-4-4-2-2\" data-name=\"tools list item (Deallahdey Properties)\">\n                        Used clear sections for services, trust-building, and contact\n                    </li>\n                    <li data-kid=\"1-6-4-4-2-3\" data-name=\"tools list item (Deallahdey Properties)\">\n                        Focused on clean visuals and easy user navigation\n                    </li>\n                    <li data-kid=\"1-6-4-4-2-4\" data-name=\"tools list item (Deallahdey Properties)\">\n                        Designed the site to help visitors understand the brand quickly\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-4-5\" data-name=\"case study outcome section: Deallahdey Properties\">\n                <h4 data-kid=\"1-6-4-5-1\" data-name=\"section label: Outcome (Deallahdey Properties)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-4-5-2\" data-name=\"outcome text: Deallahdey Properties\">\n                    The site presents property services and includes contact information for enquiries.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-4-6\" data-name=\"view live site button: Deallahdey Properties\" href=\"https://deallahdey-properties.netlify.app/\" target=\"_blank\">\n                View Live Site\n            </a>\n            <a class=\"btn-card\" data-kid=\"1-6-4-7\" data-name=\"back to portfolio button: Deallahdey Properties\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-5\" data-name=\"case study: DE-GREAT School\" id=\"case1\">\n            <h2 data-kid=\"1-6-5-1\" data-name=\"case study headline: DE-GREAT School\">\n                DE-GREAT School Website\n            </h2>\n            <h3 data-kid=\"1-6-5-2\" data-name=\"case study subtype subtitle: DE-GREAT School\">\n                Responsive School Website Project\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-5-3\" data-name=\"case study overview section: DE-GREAT School\">\n                <h4 data-kid=\"1-6-5-3-1\" data-name=\"section label: Overview (DE-GREAT School)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-5-3-2\" data-name=\"overview text: DE-GREAT School\">\n                    A school website with Home, About, Gallery, and Contact pages for presenting information to parents and visitors.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-5-4\" data-name=\"case study tools section: DE-GREAT School\">\n                <h4 data-kid=\"1-6-5-4-1\" data-name=\"section label: Tools & Process (DE-GREAT School)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-5-4-2\" data-name=\"tools list: DE-GREAT School\">\n                    <li data-kid=\"1-6-5-4-2-1\" data-name=\"tools list item: tech stack (DE-GREAT School)\">\n                        Built with\n                        <strong data-kid=\"1-6-5-4-2-1-1\" data-name=\"tech stack emphasis text (DE-GREAT School)\">\n                            HTML, CSS, and JavaScript\n                        </strong>\n                    </li>\n                    <li data-kid=\"1-6-5-4-2-2\" data-name=\"tools list item: responsive design (DE-GREAT School)\">\n                        Responsive design optimized for all devices\n                    </li>\n                    <li data-kid=\"1-6-5-4-2-3\" data-name=\"tools list item: pages list (DE-GREAT School)\">\n                        Pages: Homepage, About, Gallery, Contact\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-5-5\" data-name=\"case study outcome section: DE-GREAT School\">\n                <h4 data-kid=\"1-6-5-5-1\" data-name=\"section label: Outcome (DE-GREAT School)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-5-5-2\" data-name=\"outcome text: DE-GREAT School\">\n                    The website organizes school information across Home, About, Gallery, and Contact pages.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-5-6\" data-name=\"back to portfolio button: DE-GREAT School\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-6\" data-name=\"case study: Mentor Connect Dashboard\" id=\"case2\">\n            <h2 data-kid=\"1-6-6-1\" data-name=\"case study headline: Mentor Connect Dashboard\">\n                Mentor & Mentee Connect Dashboard\n            </h2>\n            <h3 data-kid=\"1-6-6-2\" data-name=\"case study subtype subtitle: Mentor Connect Dashboard\">\n                Responsive Frontend Dashboard\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-6-3\" data-name=\"case study overview section: Mentor Connect Dashboard\">\n                <h4 data-kid=\"1-6-6-3-1\" data-name=\"section label: Overview (Mentor Connect Dashboard)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-6-3-2\" data-name=\"overview text: Mentor Connect Dashboard\">\n                    A responsive mentor-mentee dashboard with views for user activity, sessions, and engagement statistics.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-6-4\" data-name=\"case study tools section: Mentor Connect Dashboard\">\n                <h4 data-kid=\"1-6-6-4-1\" data-name=\"section label: Tools & Process (Mentor Connect Dashboard)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-6-4-2\" data-name=\"tools list: Mentor Connect Dashboard\">\n                    <li data-kid=\"1-6-6-4-2-1\" data-name=\"tools list item: HTML and CSS (Mentor Connect Dashboard)\">\n                        HTML and CSS for structure and custom styling\n                    </li>\n                    <li data-kid=\"1-6-6-4-2-2\" data-name=\"tools list item: responsive layout (Mentor Connect Dashboard)\">\n                        Responsive layout optimized for desktop and mobile devices\n                    </li>\n                    <li data-kid=\"1-6-6-4-2-3\" data-name=\"tools list item: jQuery (Mentor Connect Dashboard)\">\n                        jQuery for collapsible menus and navbar interaction\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-6-5\" data-name=\"case study outcome section: Mentor Connect Dashboard\">\n                <h4 data-kid=\"1-6-6-5-1\" data-name=\"section label: Outcome (Mentor Connect Dashboard)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-6-5-2\" data-name=\"outcome text: Mentor Connect Dashboard\">\n                    The dashboard brings mentor, request, session, and engagement information into one interface.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-6-6\" data-name=\"back to portfolio button: Mentor Connect Dashboard\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-7\" data-name=\"case study: DeepOcean Clone\" id=\"case3\">\n            <h2 data-kid=\"1-6-7-1\" data-name=\"case study headline: DeepOcean Clone\">\n                DeepOcean Frontpage Clone\n            </h2>\n            <h3 data-kid=\"1-6-7-2\" data-name=\"case study subtype subtitle: DeepOcean Clone\">\n                Responsive Frontend Cloning Project\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-7-3\" data-name=\"case study overview section: DeepOcean Clone\">\n                <h4 data-kid=\"1-6-7-3-1\" data-name=\"section label: Overview (DeepOcean Clone)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-7-3-2\" data-name=\"overview text: DeepOcean Clone\">\n                    This project recreates a modern corporate homepage with hero banners, service highlights, ESG content, and media sections while keeping the layout responsive.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-7-4\" data-name=\"case study tools section: DeepOcean Clone\">\n                <h4 data-kid=\"1-6-7-4-1\" data-name=\"section label: Tools & Process (DeepOcean Clone)\">\n                    Tools & Process\n                </h4>\n                <ul data-kid=\"1-6-7-4-2\" data-name=\"tools list: DeepOcean Clone\">\n                    <li data-kid=\"1-6-7-4-2-1\" data-name=\"tools list item: HTML5 and CSS3 (DeepOcean Clone)\">\n                        HTML5 and CSS3 for semantic structure and custom styling\n                    </li>\n                    <li data-kid=\"1-6-7-4-2-2\" data-name=\"tools list item: CSS Grid and Flexbox (DeepOcean Clone)\">\n                        CSS Grid and Flexbox for layout consistency\n                    </li>\n                    <li data-kid=\"1-6-7-4-2-3\" data-name=\"tools list item: media queries (DeepOcean Clone)\">\n                        Media queries for responsive design across devices\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-7-5\" data-name=\"case study outcome section: DeepOcean Clone\">\n                <h4 data-kid=\"1-6-7-5-1\" data-name=\"section label: Outcome (DeepOcean Clone)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-7-5-2\" data-name=\"outcome text: DeepOcean Clone\">\n                    This recreation includes responsive layouts for the homepage's hero, service, ESG, and media sections.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-7-6\" data-name=\"back to portfolio button: DeepOcean Clone\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n        <div class=\"case-study\" data-kid=\"1-6-8\" data-name=\"case study: Aptech Homepage\" id=\"case4\">\n            <h2 data-kid=\"1-6-8-1\" data-name=\"case study headline: Aptech Homepage Design\">\n                Aptech Homepage Design\n            </h2>\n            <h3 data-kid=\"1-6-8-2\" data-name=\"case study subtype subtitle: Aptech Homepage Design\">\n                Responsive Frontend Project\n            </h3>\n            <div class=\"cs-section\" data-kid=\"1-6-8-3\" data-name=\"case study overview section: Aptech Homepage Design\">\n                <h4 data-kid=\"1-6-8-3-1\" data-name=\"section label: Overview (Aptech Homepage Design)\">\n                    Overview\n                </h4>\n                <p data-kid=\"1-6-8-3-2\" data-name=\"overview text: Aptech Homepage Design\">\n                    The Aptech Homepage Design project shows a modern, fully responsive homepage with a professional layout for a tech education brand.\n                </p>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-8-4\" data-name=\"case study tools section: Aptech Homepage Design\">\n                <h4 data-kid=\"1-6-8-4-1\" data-name=\"section label: Process & Tools (Aptech Homepage Design)\">\n                    Process & Tools\n                </h4>\n                <ul data-kid=\"1-6-8-4-2\" data-name=\"tools list: Aptech Homepage Design\">\n                    <li data-kid=\"1-6-8-4-2-1\" data-name=\"tools list item: semantic HTML5 (Aptech)\">\n                        Semantic HTML5 structure\n                    </li>\n                    <li data-kid=\"1-6-8-4-2-2\" data-name=\"tools list item: Flexbox and Grid (Aptech)\">\n                        CSS Flexbox and Grid for layouts\n                    </li>\n                    <li data-kid=\"1-6-8-4-2-3\" data-name=\"tools list item: media queries (Aptech)\">\n                        CSS media queries for responsiveness\n                    </li>\n                    <li data-kid=\"1-6-8-4-2-4\" data-name=\"tools list item: hamburger menu (Aptech)\">\n                        CSS-only hamburger menu with animated toggle\n                    </li>\n                    <li data-kid=\"1-6-8-4-2-5\" data-name=\"tools list item: theme styling (Aptech)\">\n                        Theme styling with a navy and gold palette\n                    </li>\n                </ul>\n            </div>\n            <div class=\"cs-section\" data-kid=\"1-6-8-5\" data-name=\"case study outcome section: Aptech Homepage Design\">\n                <h4 data-kid=\"1-6-8-5-1\" data-name=\"section label: Outcome (Aptech Homepage Design)\">\n                    Outcome\n                </h4>\n                <p data-kid=\"1-6-8-5-2\" data-name=\"outcome text: Aptech Homepage Design\">\n                    The final homepage includes a sticky header, hero section with overlay, bootcamp highlights, team showcase, and job opportunities section.\n                </p>\n            </div>\n            <a class=\"btn-card\" data-kid=\"1-6-8-6\" data-name=\"back to portfolio button: Aptech Homepage Design\" href=\"#portfolio\">\n                Back to Portfolio\n            </a>\n        </div>\n    </section>\n    <section class=\"section-alt\" data-kid=\"1-7\" data-name=\"workflow process section\" id=\"process\">\n        <h2 data-kid=\"1-7-1\" data-name=\"process section heading\">\n            How I Work\n        </h2>\n        <div class=\"process-grid\" data-kid=\"1-7-2\" data-name=\"process steps grid\">\n            <div class=\"process-step\" data-kid=\"1-7-2-1\" data-name=\"process step: Consultation\">\n                <span data-kid=\"1-7-2-1-1\" data-name=\"step number badge: 01 Consultation\">\n                    01\n                </span>\n                <h3 data-kid=\"1-7-2-1-2\" data-name=\"step title: Consultation\">\n                    Consultation\n                </h3>\n                <p data-kid=\"1-7-2-1-3\" data-name=\"step description: Consultation\">\n                    I discuss your goals, audience, and the website or product interface you want to create.\n                </p>\n            </div>\n            <div class=\"process-step\" data-kid=\"1-7-2-2\" data-name=\"process step: Design Direction\">\n                <span data-kid=\"1-7-2-2-1\" data-name=\"step number badge: 02 Design Direction\">\n                    02\n                </span>\n                <h3 data-kid=\"1-7-2-2-2\" data-name=\"step title: Design Direction\">\n                    Design Direction\n                </h3>\n                <p data-kid=\"1-7-2-2-3\" data-name=\"step description: Design Direction\">\n                    I plan the structure, layout, and visual direction for a website or product interface.\n                </p>\n            </div>\n            <div class=\"process-step\" data-kid=\"1-7-2-3\" data-name=\"process step: Development\">\n                <span data-kid=\"1-7-2-3-1\" data-name=\"step number badge: 03 Development\">\n                    03\n                </span>\n                <h3 data-kid=\"1-7-2-3-2\" data-name=\"step title: Development\">\n                    Development\n                </h3>\n                <p data-kid=\"1-7-2-3-3\" data-name=\"step description: Development\">\n                    I build responsive websites and develop clear interface layouts for digital products.\n                </p>\n            </div>\n            <div class=\"process-step\" data-kid=\"1-7-2-4\" data-name=\"process step: Review & Launch\">\n                <span data-kid=\"1-7-2-4-1\" data-name=\"step number badge: 04 Review & Launch\">\n                    04\n                </span>\n                <h3 data-kid=\"1-7-2-4-2\" data-name=\"step title: Review & Launch\">\n                    Review & Launch\n                </h3>\n                <p data-kid=\"1-7-2-4-3\" data-name=\"step description: Review & Launch\">\n                    I review the website or product interface, make refinements, and prepare the work for its next stage.\n                </p>\n            </div>\n        </div>\n    </section>\n    <section data-kid=\"1-8\" data-name=\"approach section\" id=\"testimonial\">\n        <h2 data-kid=\"1-8-1\" data-name=\"approach section heading\">\n            My Approach\n        </h2>\n        <div class=\"testimonial-box\" data-kid=\"1-8-2\" data-name=\"approach statement box\">\n            <p data-kid=\"1-8-2-1\" data-name=\"approach statement text\">\n                I design digital product interfaces and build responsive websites with clear layouts and straightforward navigation.\n            </p>\n        </div>\n    </section>\n    <section data-kid=\"1-9\" data-name=\"contact section\" id=\"contact\">\n        <h2 data-kid=\"1-9-1\" data-name=\"contact section heading\">\n            Let’s Create Your Next Digital Experience\n        </h2>\n        <div class=\"contact\" data-kid=\"1-9-2\" data-name=\"contact details container\">\n            <p class=\"contact-intro\" data-kid=\"1-9-2-1\" data-name=\"contact intro text\">\n                Have a website or product project in mind? Reach out by WhatsApp or email to discuss your idea.\n            </p>\n            <a class=\"btn contact-cta\" data-kid=\"1-9-2-2\" data-name=\"primary WhatsApp contact button\" href=\"https://wa.me/2348147063728\" target=\"_blank\">\n                Contact Me on WhatsApp\n            </a>\n            <ul class=\"contact-list\" data-kid=\"1-9-2-3\" data-name=\"contact channels list\">\n                <li data-kid=\"1-9-2-3-1\" data-name=\"email contact list item\">\n                    <a data-kid=\"1-9-2-3-1-1\" data-name=\"email contact link\" href=\"mailto:akporiomeconstance1@gmail.com\" target=\"_blank\">\n                        <img alt=\"Gmail logo\" class=\"contact-icon\" data-kid=\"1-9-2-3-1-1-1\" data-name=\"Gmail icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/gmail.jpg\"/>\n                        akporiomeconstance1@gmail.com\n                    </a>\n                </li>\n                <li data-kid=\"1-9-2-3-2\" data-name=\"LinkedIn contact list item\">\n                    <a data-kid=\"1-9-2-3-2-1\" data-name=\"LinkedIn contact link\" href=\"https://linkedin.com/in/constance-ogheneyome\" target=\"_blank\">\n                        <img alt=\"LinkedIn logo\" class=\"contact-icon\" data-kid=\"1-9-2-3-2-1-1\" data-name=\"LinkedIn icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/linkedin.png\"/>\n                        linkedin.com/in/constance-ogheneyome\n                    </a>\n                </li>\n                <li data-kid=\"1-9-2-3-3\" data-name=\"WhatsApp contact list item\">\n                    <a data-kid=\"1-9-2-3-3-1\" data-name=\"WhatsApp contact link\" href=\"https://wa.me/2348147063728\" target=\"_blank\">\n                        <img alt=\"WhatsApp logo\" class=\"contact-icon\" data-kid=\"1-9-2-3-3-1-1\" data-name=\"WhatsApp icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/whatsapp.jpg\"/>\n                        +234 814 706 3728\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </section>\n    <footer data-kid=\"1-10\" data-name=\"site footer\">\n        <p data-kid=\"1-10-1\" data-name=\"footer copyright text\">\n            © 2025 Akporiome Constance | All Rights Reserved\n        </p>\n    </footer>\n</div>\n",
