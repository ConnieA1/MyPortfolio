        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    :root {\n    --dark: #101010;\n    --text: #252525;\n    --muted: #666666;\n    --light: #f7f4ef;\n    --white: #ffffff;\n    --gold: #f39c12;\n    --gold-dark: #d97806;\n    --border: rgba(16, 16, 16, 0.1);\n    --card-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);\n  }\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: var(--white);\n    color: var(--text);\n    font-family: \"Segoe UI\", Tahoma, Geneva, Verdana, sans-serif;\n    line-height: 1.6;\n  }\n\n  a { color: inherit; text-decoration: none; }\n\n  .site-header {\n    position: fixed;\n    inset: 0 0 auto;\n    z-index: 20;\n    padding: 1rem 2rem;\n    color: var(--white);\n    background: rgba(16, 16, 16, 0.96);\n    backdrop-filter: blur(12px);\n  }\n\n  .nav-inner {\n    position: relative;\n    display: flex;\n    max-width: 1180px;\n    margin: 0 auto;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .wordmark {\n    margin: 0;\n    color: var(--white);\n    font-size: 1.35rem;\n    line-height: 1.3;\n    font-weight: 700;\n  }\n\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 1.5rem;\n  }\n\n  .nav-links a {\n    color: var(--white);\n    font-size: 0.95rem;\n    transition: color 180ms ease;\n  }\n\n  .nav-links a:hover { color: var(--gold); }\n\n  .nav-toggle, .mobile-close, .mobile-menu-button { display: none; }\n\n  .portfolio-section {\n    width: 100%;\n    max-width: 1120px;\n    margin: 0 auto;\n    padding: 6.8rem 2rem 5.5rem;\n    box-sizing: border-box;\n    scroll-margin-top: 5rem;\n  }\n\n  .portfolio-section h1 {\n    margin: 0 0 0.9rem;\n    color: var(--dark);\n    text-align: center;\n    font-size: clamp(1.9rem, 4vw, 2.6rem);\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .section-intro {\n    max-width: 720px;\n    margin: 0 auto 2rem;\n    color: var(--muted);\n    text-align: center;\n    font-size: 1rem;\n  }\n\n  .category-switcher {\n    position: relative;\n    min-width: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  .visually-hidden {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    white-space: nowrap;\n    clip-path: inset(50%);\n    border: 0;\n  }\n\n  .switch-controls {\n    display: flex;\n    width: fit-content;\n    max-width: 100%;\n    min-height: 48px;\n    margin: 0 auto 2rem;\n    padding: 4px;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    border: 1px solid var(--border);\n    border-radius: 999px;\n    background: var(--light);\n    box-sizing: border-box;\n  }\n\n  .switch-option {\n    display: inline-flex;\n    min-height: 42px;\n    padding: 0.55rem 1.35rem;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid transparent;\n    border-radius: 999px;\n    color: var(--text);\n    font-size: 0.96rem;\n    font-weight: 700;\n    line-height: 1.2;\n    white-space: nowrap;\n    cursor: pointer;\n    box-sizing: border-box;\n    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;\n  }\n\n  #websites:checked ~ .switch-controls label[for=\"websites\"],\n  #product-design:checked ~ .switch-controls label[for=\"product-design\"] {\n    background: var(--dark);\n    color: var(--gold);\n  }\n\n  #websites:focus-visible ~ .switch-controls label[for=\"websites\"],\n  #product-design:focus-visible ~ .switch-controls label[for=\"product-design\"] {\n    outline: 3px solid var(--gold-dark);\n    outline-offset: 3px;\n  }\n\n  .portfolio-panels { width: 100%; }\n\n  .websites-panel {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    align-items: stretch;\n    gap: 1.5rem;\n  }\n\n  .project-card {\n    display: flex;\n    min-width: 0;\n    height: 100%;\n    flex-direction: column;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    background: var(--white);\n    box-shadow: var(--card-shadow);\n    box-sizing: border-box;\n    transition: transform 180ms ease, box-shadow 180ms ease;\n  }\n\n  .project-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);\n  }\n\n  .project-image {\n    display: block;\n    width: 100%;\n    height: 210px;\n    flex: 0 0 210px;\n    object-fit: cover;\n    background: var(--light);\n  }\n\n  .card-content {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    padding: 1.2rem;\n    box-sizing: border-box;\n  }\n\n  .card-content h2 {\n    margin: 0 0 0.55rem;\n    color: var(--dark);\n    text-align: left;\n    font-size: 1.2rem;\n    line-height: 1.4;\n    font-weight: 700;\n  }\n\n  .card-content p {\n    flex: 1;\n    margin: 0 0 1rem;\n    color: var(--muted);\n    font-size: 0.95rem;\n    line-height: 1.5;\n  }\n\n  .project-link {\n    display: inline-flex;\n    width: fit-content;\n    min-height: 48px;\n    margin-top: auto;\n    padding: 0.72rem 1.35rem;\n    align-items: center;\n    justify-content: center;\n    border-radius: 999px;\n    background: var(--gold);\n    color: var(--white);\n    font-size: 0.95rem;\n    font-weight: 700;\n    line-height: 1.2;\n    transition: background-color 160ms ease, transform 160ms ease;\n  }\n\n  .project-link:hover {\n    transform: translateY(-2px);\n    background: var(--gold-dark);\n  }\n\n  .project-link:focus-visible,\n  .nav-links a:focus-visible,\n  .mobile-menu-button:focus-visible,\n  .mobile-close:focus-visible {\n    outline: 3px solid var(--gold);\n    outline-offset: 3px;\n  }\n\n  #product-design:checked ~ .portfolio-panels .websites-panel { display: none; }\n\n  .product-panel {\n    display: none;\n    min-height: 560px;\n    padding: 2rem 1rem;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    text-align: center;\n    box-sizing: border-box;\n  }\n\n  #product-design:checked ~ .portfolio-panels .product-panel { display: flex; }\n\n  .product-panel h2 {\n    max-width: 32rem;\n    margin: 0 0 0.7rem;\n    color: var(--dark);\n    font-size: clamp(1.6rem, 3vw, 2.15rem);\n    line-height: 1.25;\n  }\n\n  .product-panel p {\n    max-width: 34rem;\n    margin: 0;\n    color: var(--muted);\n    font-size: 1rem;\n  }\n\n  @media (max-width: 1100px) {\n    .portfolio-section { max-width: 100%; }\n    .websites-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  }\n\n  @media (max-width: 768px) {\n    .site-header { padding: 1rem; }\n    .nav-toggle {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      opacity: 0;\n    }\n    .mobile-menu-button {\n      display: inline-flex;\n      width: 34px;\n      height: 34px;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n    }\n    .mobile-menu-button img, .mobile-close img { width: 32px; height: 32px; }\n    .mobile-close { display: none; cursor: pointer; }\n    .nav-links {\n      position: absolute;\n      top: 50px;\n      right: 0;\n      display: none;\n      width: 230px;\n      padding: 0.4rem 0;\n      flex-direction: column;\n      align-items: stretch;\n      gap: 0;\n      border-radius: 0 0 8px 8px;\n      background: var(--dark);\n      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);\n    }\n    .nav-links a { padding: 0.9rem 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }\n    #nav-toggle:checked ~ .nav-links { display: flex; }\n    #nav-toggle:checked ~ .mobile-menu-button { display: none; }\n    #nav-toggle:checked ~ .mobile-close { display: inline-flex; }\n    .portfolio-section { padding: 6.4rem 1.2rem 4.5rem; }\n    .product-panel { min-height: 420px; }\n  }\n\n  @media (max-width: 600px) {\n    .websites-panel { grid-template-columns: minmax(0, 1fr); }\n    .portfolio-section { padding-right: 1.2rem; padding-left: 1.2rem; }\n    .section-intro { margin-bottom: 1.5rem; }\n    .switch-controls { margin-bottom: 1.5rem; }\n    .switch-option { padding-right: 1rem; padding-left: 1rem; }\n    .product-panel { min-height: 300px; padding-right: 0; padding-left: 0; }\n  }\n</style>\n<header class=\"site-header\" data-kid=\"1\">\n    <div class=\"nav-inner\" data-kid=\"1-1\">\n        <h2 class=\"wordmark\" data-kid=\"1-1-1\" data-name=\"site wordmark logo\">\n            Constance\n        </h2>\n        <input aria-label=\"Toggle navigation menu\" class=\"nav-toggle\" data-kid=\"1-1-2\" id=\"nav-toggle\" type=\"checkbox\"/>\n        <label aria-label=\"Open navigation menu\" class=\"mobile-menu-button\" data-kid=\"1-1-3\" for=\"nav-toggle\">\n            <img alt=\"\" data-kid=\"1-1-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/menu-icon.png\"/>\n        </label>\n        <label aria-label=\"Close navigation menu\" class=\"mobile-close\" data-kid=\"1-1-4\" for=\"nav-toggle\">\n            <img alt=\"\" data-kid=\"1-1-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/close-icon.png\"/>\n        </label>\n        <nav aria-label=\"Main navigation\" class=\"nav-links\" data-kid=\"1-1-5\">\n            <a data-kid=\"1-1-5-1\" href=\"#hero\">\n                Home\n            </a>\n            <a data-kid=\"1-1-5-2\" data-name=\"About navigation link\" href=\"#about\">\n                About\n            </a>\n            <a data-kid=\"1-1-5-3\" data-name=\"Services navigation link\" href=\"#services\">\n                Services\n            </a>\n            <a data-kid=\"1-1-5-4\" data-name=\"Portfolio navigation link\" href=\"#portfolio\">\n                Portfolio\n            </a>\n            <a data-kid=\"1-1-5-5\" data-name=\"Contact navigation link\" href=\"#contact\">\n                Contact\n            </a>\n        </nav>\n    </div>\n</header>\n<main data-kid=\"2\">\n    <section aria-labelledby=\"portfolio-title\" class=\"portfolio-section\" data-kid=\"2-1\" data-name=\"portfolio section\" id=\"portfolio\">\n        <h1 data-kid=\"2-1-1\" data-name=\"portfolio section headline\" id=\"portfolio-title\">\n            Featured Projects\n        </h1>\n        <p class=\"section-intro\" data-kid=\"2-1-2\" data-name=\"portfolio section intro text\">\n            A selection of responsive projects showing website layout, business presentation, and client-focused design.\n        </p>\n        <fieldset class=\"category-switcher\" data-kid=\"2-1-3\" data-name=\"project category switcher control\">\n            <legend class=\"visually-hidden\" data-kid=\"2-1-3-1\" data-name=\"visually hidden switcher legend\">\n                Choose a project category\n            </legend>\n            <input checked=\"\" class=\"visually-hidden\" data-kid=\"2-1-3-2\" data-name=\"websites category radio input\" id=\"websites\" name=\"project-category\" type=\"radio\" value=\"websites\"/>\n            <input class=\"visually-hidden\" data-kid=\"2-1-3-3\" data-name=\"product design category radio input\" id=\"product-design\" name=\"project-category\" type=\"radio\" value=\"product-design\"/>\n            <div class=\"switch-controls\" data-kid=\"2-1-3-4\" data-name=\"category switch toggle pill bar\">\n                <label class=\"switch-option\" data-kid=\"2-1-3-4-1\" data-name=\"websites category toggle option\" for=\"websites\">\n                    Websites\n                </label>\n                <label class=\"switch-option\" data-kid=\"2-1-3-4-2\" data-name=\"product design category toggle option\" for=\"product-design\">\n                    Product Design\n                </label>\n            </div>\n            <div class=\"portfolio-panels\" data-kid=\"2-1-3-5\" data-name=\"portfolio panels container\">\n                <div aria-label=\"Website projects\" class=\"websites-panel\" data-kid=\"2-1-3-5-1\" data-name=\"websites projects grid panel\">\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-1\" data-name=\"De Amazing School project card\">\n                        <img alt=\"De Amazing School website preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-1-1\" data-name=\"De Amazing School preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/deamazing-school.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-1-2\" data-name=\"De Amazing School card body\">\n                            <h2 data-kid=\"2-1-3-5-1-1-2-1\" data-name=\"De Amazing School project title\">\n                                De Amazing School Website\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-1-2-2\" data-name=\"De Amazing School project description\">\n                                A live school website built to present school information, improve parent communication, and create a professional online presence.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-1-2-3\" data-name=\"De Amazing School view details button\" href=\"#case5\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-2\" data-name=\"Ideal360 project card\">\n                        <img alt=\"Ideal360 website preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-2-1\" data-name=\"Ideal360 preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ideal360.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-2-2\" data-name=\"Ideal360 card body\">\n                            <h2 data-kid=\"2-1-3-5-1-2-2-1\" data-name=\"Ideal360 project title\">\n                                Ideal360 Website\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-2-2-2\" data-name=\"Ideal360 project description\">\n                                A responsive business website designed to showcase services clearly and help visitors understand the brand quickly.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-2-2-3\" data-name=\"Ideal360 view details button\" href=\"#case6\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-3\" data-name=\"Olushola Akinrimisi project card\">\n                        <img alt=\"Olushola Akinrimisi birthday tribute website preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-3-1\" data-name=\"Olushola Akinrimisi preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/olushola-akinrimisi.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-3-2\" data-name=\"Olushola Akinrimisi card body\">\n                            <h2 data-kid=\"2-1-3-5-1-3-2-1\" data-name=\"Olushola Akinrimisi project title\">\n                                Olushola Akinrimisi Birthday Tribute\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-3-2-2\" data-name=\"Olushola Akinrimisi project description\">\n                                A birthday tribute website created to celebrate a special occasion with a warm design, personal message, and memorable online presentation.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-3-2-3\" data-name=\"Olushola Akinrimisi view details button\" href=\"#case7\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-4\" data-name=\"Deallahdey Properties project card\">\n                        <img alt=\"Deallahdey Properties website preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-4-1\" data-name=\"Deallahdey Properties preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/deallahdey-properties.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-4-2\" data-name=\"Deallahdey Properties card body\">\n                            <h2 data-kid=\"2-1-3-5-1-4-2-1\" data-name=\"Deallahdey Properties project title\">\n                                Deallahdey Properties Website\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-4-2-2\" data-name=\"Deallahdey Properties project description\">\n                                A real estate website built to showcase property services, build trust, and make it easier for potential clients to connect.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-4-2-3\" data-name=\"Deallahdey Properties view details button\" href=\"#case8\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-5\" data-name=\"DE-GREAT School project card\">\n                        <img alt=\"DE-GREAT School Website preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-5-1\" data-name=\"DE-GREAT School preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/school-cs.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-5-2\" data-name=\"DE-GREAT School card body\">\n                            <h2 data-kid=\"2-1-3-5-1-5-2-1\" data-name=\"DE-GREAT School project title\">\n                                DE-GREAT School Website\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-5-2-2\" data-name=\"DE-GREAT School project description\">\n                                A responsive school website designed to improve online visibility and make school information easier to access.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-5-2-3\" data-name=\"DE-GREAT School view details button\" href=\"#case1\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-6\" data-name=\"Mentup Konnect project card\">\n                        <img alt=\"Mentup Konnect Dashboard preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-6-1\" data-name=\"Mentup Konnect preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/mentee-screenshot.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-6-2\" data-name=\"Mentup Konnect card body\">\n                            <h2 data-kid=\"2-1-3-5-1-6-2-1\" data-name=\"Mentup Konnect project title\">\n                                Mentup Konnect Dashboard\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-6-2-2\" data-name=\"Mentup Konnect project description\">\n                                A clean dashboard interface for tracking mentorship activity, sessions, and user engagement.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-6-2-3\" data-name=\"Mentup Konnect view details button\" href=\"#case2\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-7\" data-name=\"DeepOcean project card\">\n                        <img alt=\"DeepOcean frontpage clone preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-7-1\" data-name=\"DeepOcean preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/deepocean-media.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-7-2\" data-name=\"DeepOcean card body\">\n                            <h2 data-kid=\"2-1-3-5-1-7-2-1\" data-name=\"DeepOcean project title\">\n                                DeepOcean Frontpage Clone\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-7-2-2\" data-name=\"DeepOcean project description\">\n                                A responsive corporate homepage recreation focused on layout accuracy, structure, and professional presentation.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-7-2-3\" data-name=\"DeepOcean view details button\" href=\"#case3\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"project-card\" data-kid=\"2-1-3-5-1-8\" data-name=\"Aptech project card\">\n                        <img alt=\"Aptech homepage design preview\" class=\"project-image\" data-kid=\"2-1-3-5-1-8-1\" data-name=\"Aptech preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/aptech-cs.png\"/>\n                        <div class=\"card-content\" data-kid=\"2-1-3-5-1-8-2\" data-name=\"Aptech card body\">\n                            <h2 data-kid=\"2-1-3-5-1-8-2-1\" data-name=\"Aptech project title\">\n                                Aptech Homepage Design\n                            </h2>\n                            <p data-kid=\"2-1-3-5-1-8-2-2\" data-name=\"Aptech project description\">\n                                A polished education homepage design with clear navigation, strong sections, and mobile responsiveness.\n                            </p>\n                            <a class=\"project-link\" data-kid=\"2-1-3-5-1-8-2-3\" data-name=\"Aptech view details button\" href=\"#case4\">\n                                View Details\n                            </a>\n                        </div>\n                    </article>\n                </div>\n                <div aria-labelledby=\"product-panel-title\" class=\"product-panel\" data-kid=\"2-1-3-5-2\" data-name=\"product design placeholder panel\">\n                    <h2 data-kid=\"2-1-3-5-2-1\" data-name=\"product design placeholder headline\" id=\"product-panel-title\">\n                        Product design case study coming soon.\n                    </h2>\n                    <p data-kid=\"2-1-3-5-2-2\" data-name=\"product design placeholder text\">\n                        A product design case study will be added here.\n                    </p>\n                </div>\n            </div>\n        </fieldset>\n    </section>\n</main>\n",
